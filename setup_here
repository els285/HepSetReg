#!/usr/bin/env bash
# Like setup_bsc, but puts EVERYTHING uv manages -- its own binary, the
# Python interpreter it downloads, the wheel cache, and the project's
# .venv -- under one directory you choose, instead of defaulting to $HOME
# (uv's own binary install location) and the repo's own directory (.venv).
# That matters on a system with a tiny, quota-limited home (e.g. lxplus's
# AFS $HOME): none of that -- easily several hundred MB to a few GB once
# torch/CUDA wheels are in the mix -- ever touches $HOME here.
#
# Usage (from a fresh git clone):
#   cd HepSetReg
#   ./setup_here [base_dir]
#
# base_dir defaults to the current directory ($PWD) -- e.g. if you've
# already cloned onto EOS/work/scratch space instead of AFS, running this
# from there with no argument is enough. Pass a path explicitly to put the
# uv/Python/venv footprint somewhere other than where the repo itself
# lives, e.g.:
#   ./setup_here /eos/user/e/esimpson/hepsetreg-env

set -euo pipefail

# Colors only when writing to an actual terminal -- if output is redirected
# to a file or piped somewhere, the escape codes would just be garbage in
# the log instead of colors, so fall back to plain text there.
if [ -t 1 ]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; RESET=''
fi
step()    { echo "${BOLD}${CYAN}== $* ==${RESET}"; }
ok()      { echo "${GREEN}$*${RESET}"; }
warn()    { echo "${YELLOW}$*${RESET}"; }
err()     { echo "${RED}ERROR: $*${RESET}" >&2; }

trap 'err "setup_here failed at line $LINENO -- see the message above for which step this was."' ERR

# Public CERNBox folder share holding train/val/test together -- the bare
# share link downloads the whole folder as a tarball, so individual files
# are fetched via its `?files=<name>` query param instead.
FOLDER_SHARE="https://cernbox.cern.ch/s/Pd5y969ajhIi4b3/download?files="
DATA_DIR="datasets"
TRAIN_FILE="$DATA_DIR/ttbar-2L_train_051026.parquet"
VAL_FILE="$DATA_DIR/ttbar-2L_val_051026.parquet"
TEST_FILE="$DATA_DIR/ttbar-2L_test_051026.parquet"
MIN_DATA_BYTES=1000000  # a truncated/failed download would be far smaller than this

# Downloads one file from FOLDER_SHARE, skipping if it's already there, and
# checking the result is at least MIN_DATA_BYTES (not a truncated download
# or an HTML error page saved as if it were data).
download_file() {
    local remote_name="$1" dest="$2"
    local url="${FOLDER_SHARE}${remote_name}"

    if [ -f "$dest" ] && [ "$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest")" -ge "$MIN_DATA_BYTES" ]; then
        ok "$dest already downloaded, skipping."
        return
    fi

    echo "Downloading $remote_name to $dest ..."
    # --fail: treat HTTP error responses (404, 403, ...) as failures instead of
    # silently saving the error page as if it were the data file.
    # --retry: tolerate a flaky connection.
    if ! curl --fail --retry 3 -L -o "$dest" "$url"; then
        err "download failed. Check your network connection and that"
        echo "${RED}$url is still a valid link.${RESET}" >&2
        rm -f "$dest"
        exit 1
    fi

    local actual_bytes
    actual_bytes=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest")
    if [ "$actual_bytes" -lt "$MIN_DATA_BYTES" ]; then
        err "$dest is only $actual_bytes bytes -- looks like a failed"
        echo "${RED}or truncated download, not real data (re-run this script to retry).${RESET}" >&2
        rm -f "$dest"
        exit 1
    fi
    ok "$dest OK ($actual_bytes bytes)"
}

# ---- sanity check: are we in the right place? ----
# (the most likely real mistake: running this before `cd`-ing into the clone)
if [ ! -f "pyproject.toml" ]; then
    err "no pyproject.toml here. Run this script from inside the"
    echo "${RED}HepSetReg directory you just cloned (cd HepSetReg first).${RESET}" >&2
    exit 1
fi

# ---- step 0: where does everything uv-related go? ----
step "Step 0: choosing where uv's files live"
BASE="${1:-$PWD}"
mkdir -p "$BASE"
BASE="$(cd "$BASE" && pwd)"  # absolute, so this still works if you later cd elsewhere

export UV_INSTALL_DIR="$BASE/uv-bin"           # the uv/uvx binaries themselves
export UV_PYTHON_INSTALL_DIR="$BASE/uv-python" # the CPython interpreter uv downloads
export UV_CACHE_DIR="$BASE/uv-cache"           # downloaded wheels (can be several GB with torch/CUDA)
export UV_PROJECT_ENVIRONMENT="$BASE/.venv"    # the actual project environment
export PATH="$UV_INSTALL_DIR:$PATH"
ok "Everything uv-related will live under: $BASE"

# Writes out the four exports above (plus PATH) to a small file at the repo
# root, so a *later* shell -- one that didn't just run this script -- can
# pick up the same locations instead of uv quietly defaulting back to $HOME
# and the repo's own .venv. ./train/./predict/`uv run ...` all need this
# sourced first in any new session.
cat > .uv-env <<ENVEOF
# Generated by setup_here -- source this before using uv/./train/./predict
# in a new shell, so uv keeps using the relocated files under $BASE
# instead of defaulting back to \$HOME.
export UV_INSTALL_DIR="$UV_INSTALL_DIR"
export UV_PYTHON_INSTALL_DIR="$UV_PYTHON_INSTALL_DIR"
export UV_CACHE_DIR="$UV_CACHE_DIR"
export UV_PROJECT_ENVIRONMENT="$UV_PROJECT_ENVIRONMENT"
export PATH="$UV_INSTALL_DIR:\$PATH"
ENVEOF
ok "Wrote .uv-env -- source it in any new shell before running uv/./train/./predict."

# ---- step 1: install uv (skip if already installed at this location) ----
step "Step 1: uv"
if command -v uv &> /dev/null; then
    ok "uv already installed ($(command -v uv)), skipping install."
else
    if ! command -v curl &> /dev/null; then
        err "curl is not installed. Install curl first, then re-run this script."
        exit 1
    fi
    # UV_INSTALL_DIR (exported above) tells the installer where to put the
    # uv/uvx binaries, instead of its default $HOME/.local/bin.
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

if ! command -v uv &> /dev/null; then
    err "uv install finished but 'uv' still isn't on PATH."
    warn "Check UV_INSTALL_DIR ($UV_INSTALL_DIR) was picked up, then re-run this script."
    exit 1
fi
ok "uv OK: $(uv --version)"

# ---- step 2: download train/val/test data (skip whichever's already present) ----
step "Step 2: train/val/test data"
mkdir -p "$DATA_DIR"

download_file "ttbar-2L_train_051026.parquet" "$TRAIN_FILE"
download_file "ttbar-2L_val_051026.parquet" "$VAL_FILE"
download_file "ttbar-2L_test_051026.parquet" "$TEST_FILE"

# ---- step 3: install the Python environment ----
# Run `uv sync --extra dev` yourself if you want pytest/notebooks too.
# UV_PYTHON_INSTALL_DIR/UV_CACHE_DIR/UV_PROJECT_ENVIRONMENT (exported in
# step 0) are what actually keep this off $HOME.
step "Step 3: uv sync"
if ! uv sync; then
    err "'uv sync' failed -- see the error above. A slow/interrupted"
    echo "${RED}network is the most common cause; just re-run this script.${RESET}" >&2
    exit 1
fi
ok "Environment synced."

# ---- step 4: prove the whole chain actually works ----
# Loads the downloaded file through the project's own dataset-loading code,
# using the same field names configs/run_regression.yaml uses -- this checks
# not just "is the environment installed" but "can the package actually read
# real data", which is the thing that's actually going to be run.
step "Step 4: test run"
uv run python - "$TEST_FILE" <<'PY'
import sys
import yaml

data_file = sys.argv[1]

from hepsetreg.datasets.EventDatasetBase import load_arrays

with open("configs/run_regression.yaml") as f:
    features = yaml.safe_load(f)["features"]

global_arr, jet_arr, lepton_arr, target_arr = load_arrays(data_file, features)

print(f"Loaded {len(global_arr)} events from {data_file}")
print(f"  global features: {global_arr.shape[1]}")
print(f"  mean {features['target'][0]}: {target_arr[:, 0].mean():.1f}")
PY

echo
ok "All done. The environment is set up and the test data loads correctly."
warn "New shell? Run 'source .uv-env' here first, before ./train, ./predict, or any uv command."
echo "See README.md for how to train and predict."
