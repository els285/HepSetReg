#!/bin/bash --login
#SBATCH -p gpuL               # v100 GPUs
#SBATCH -G 1                  # 1 GPU
#SBATCH -t 1-0                # Wallclock limit (1-0 is 1 day, 4-0 is the max permitted)
#SBATCH -n 1                  # One Slurm task
#SBATCH -c 8                  # 8 CPU cores available to the host code.
                              # Can use up to 12 CPUs with an A100 GPU.
                              # Can use up to 12 CPUs with an L40s GPU.
#SBATCH --mem=64G             # Host RAM: the full train parquet is loaded into memory on construction
#SBATCH -J regression_EM      # Job name
#SBATCH -o regression_EM_%j.out  # Stdout/stderr log, %j = job ID

# Latest version of CUDA
module purge
module load libs/cuda

echo "Job is using $SLURM_GPUS GPU(s) with ID(s) $CUDA_VISIBLE_DEVICES and $SLURM_CPUS_PER_TASK CPU core(s)"

# run_regression.py caps torch to 4 threads itself; keep OpenMP in line with the allocation
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

cd /mnt/iusers01/jw01/c73320es/data/HepSetReg

# Same as submit_run_regression, but with the EMtops-augmented config --
# run_regression.py switches to TTbarEventDataModule/TTbarEventDataset and
# gives TransformerBackbone its extra EMtops tokens automatically, purely
# because configs/run_regression_EM.yaml's features: block has an "EMtops"
# entry (see src/hepsetreg/datasets/TTbarEventDataset.py).
.venv/bin/python -m hepsetreg.runs.run_regression --train --config configs/run_regression_EM.yaml
